{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepLab",
  "version": "1.0.2",
  "identifier": "com.sculab.deeplab",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @deeplab/desktop exec vite --port 5173 --strictPort",
    "beforeBuildCommand": "pnpm --filter @deeplab/desktop build"
  },
  "app": {
    "windows": [
      {
        "title": "DeepLab",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "zoomHotkeysEnabled": false,
        "trafficLightPosition": {
          "x": 13,
          "y": 26
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/uv",
      "binaries/agent-browser"
    ],
    "macOS": {
      "hardenedRuntime": true,
      "infoPlist": "./Info.plist",
      "minimumSystemVersion": "13.0"
    },
    "resources": {
      "../../../runtime/dsh": "dsh/",
      "../../../runtime/dsh-acp": "dsh-acp/",
      "../../../runtime/browser-plugin": "browser-plugin/",
      "../../../runtime/tools": "tools/",
      "../../../runtime/skills/external/ai4s-skills": "skills/",
      "../../../runtime/skills/external/anthropic-skills": "skills-office/",
      "../../../runtime/skills/external/agent-browser": "skills-agent-browser/",
      "../../../runtime/skills/core": "skills-core/",
      "../../../runtime/dsh-profile/agent": "profile/agent/",
      "../../../runtime/dsh-profile/command": "profile/command/",
      "../../../runtime/harness": "harness/",
      "../../../examples/climate-trends": "examples/climate-trends/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
